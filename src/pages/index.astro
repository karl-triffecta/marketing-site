---
import Layout from "../layouts/Layout.astro";
import TriffectaButton from "../components/TriffectaButton.tsx";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";
import { getImage, Picture } from "astro:assets";

import ImgHeroIllustration from "../assets/redesign/hero-illustration.png";
import ImgPlatformDashboard from "../assets/redesign/platform-dashboard.png";
import IconTrustVml from "../assets/redesign/trust/vml.svg?url";
import IconTrustWppMedia from "../assets/redesign/trust/wpp-media.svg?url";
import IconTrustPublicis from "../assets/redesign/trust/publicis.svg?url";
import IconTrustHaatch from "../assets/redesign/trust/haatch.svg?url";
import ImgLogoCriteo from "../assets/redesign/integrations/criteo.png";
import ImgLogoCitrusAd from "../assets/redesign/integrations/citrusad.png";
import ImgLogoAmazonAds from "../assets/redesign/integrations/amazon-ads.png";
import ImgLogoKevel from "../assets/redesign/integrations/kevel.png";

import IconProblemCost from "../assets/redesign/icons/problem-cost.svg?url";
import IconPillarExecution from "../assets/redesign/icons/pillar-execution.svg?url";
import IconPillarAnalytics from "../assets/redesign/icons/pillar-analytics.svg?url";
import IconPillarAutomation from "../assets/redesign/icons/pillar-automation.svg?url";
import IconDiffCreate from "../assets/redesign/icons/diff-create.svg?url";
import IconDiffStandardize from "../assets/redesign/icons/diff-standardize.svg?url";
import IconDiffControl from "../assets/redesign/icons/diff-control.svg?url";
import IconJourneyAutomation from "../assets/redesign/icons/journey-automation.svg?url";
import IconCommercialCampaigns from "../assets/redesign/icons/commercial-campaigns.svg?url";
import IconCommercialRetailers from "../assets/redesign/icons/commercial-retailers.svg?url";
import IconCommercialGrowth from "../assets/redesign/icons/commercial-growth.svg?url";
import IconCheck from "../assets/redesign/icons/check.svg?url";

const optimizedHeroIllustration = await getImage({
  src: ImgHeroIllustration,
  format: "webp",
  width: 1672,
});

const seo = {
  title: "Triffecta | Revolutionizing Retail Media at Scale",
  titleTemplate: "%s",
};

const posts = await getCollection("posts");
posts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const latestPosts = posts.slice(0, 3);
const postAccents = ["amber", "teal", "emerald"] as const;

const problemCards = [
  {
    label: "SETUP FRICTION",
    labelClass: "text-amber-600",
    blobClass: "bg-[#fffbeb]",
    title: "Repeated Campaign Setup",
    body: "Rebuilding the same campaign across every retailer / retail media network is a huge drain on time and resources. Every launch means repeating the same work, slowing your team down and creating room for error.",
    cost: "More setup. Less leverage.",
  },
  {
    label: "KPI MISMATCH",
    labelClass: "text-teal-700",
    blobClass: "bg-[#f0fdfa]",
    title: "Fragmented Reporting",
    body: "Different dashboards and definitions make cross-retailer performance harder to compare.",
    cost: "Disconnected metrics. Slower decisions.",
  },
  {
    label: "INERTIA",
    labelClass: "text-ink-500",
    blobClass: "bg-ink-100",
    title: "Complexity at scale",
    body: "Multiple reporting spreadsheets take time to build, reconcile and review. The more networks you add, the more resource is tied up in reporting rather than acting.",
    cost: "Growth shouldn’t mean more admin.",
  },
];

const journeyStations = [
  {
    num: "01",
    numClass: "border-amber-500/50 text-amber-400",
    title: "Create once",
    body: "Set products, target keywords, wallet budgets, and campaign parameters in one unified creation workflow.",
    bulletClass: "text-amber-400",
    bullets: [
      "Multi-product portfolio selector",
      "Unified budget & wallet caps",
      "Centralized keyword libraries",
    ],
  },
  {
    num: "02",
    numClass: "border-emerald-500/50 text-emerald-500",
    title: "Activate across networks",
    body: "Duplicate and deploy campaigns across the connected networks you select, without rebuilding the same setup in each retailer portal.",
    bulletClass: "text-emerald-500",
    bullets: [
      "Direct API execution to networks",
      "Automatic format mapping",
      "Zero redundant login overhead",
    ],
  },
  {
    num: "03",
    numClass: "border-teal-500/50 text-teal-500",
    title: "Understand performance together",
    body: "Every retailer reports differently and every retail media network provides fragmented data in its own format. Triffecta brings it together and aligns it, so you can create reports once and review performance by retailer, category or SKU.",
    bulletClass: "text-teal-500",
    bullets: [
      "Cross-retailer metric alignment",
      "True attribution normalization",
      "Consolidated executive exports",
    ],
  },
];

const platformPillars = [
  {
    title: "Campaign Execution",
    body: "Create, schedule and pace sponsored brand and sponsored product campaigns in one universal interface.",
    icon: IconPillarExecution,
    iconWrap: "border-teal-500/40 bg-[rgba(19,78,74,0.5)]",
  },
  {
    title: "Cross-Retailer Analytics",
    body: "Compare performance across connected retailers side-by-side with true attribution and currency alignment.",
    icon: IconPillarAnalytics,
    iconWrap: "border-amber-500/40 bg-[rgba(120,53,15,0.5)]",
  },
  {
    title: "Controlled Automation",
    body: "Eliminate repetitive keyword generation and budget pacing while human agency experts keep ultimate strategic control.",
    icon: IconPillarAutomation,
    iconWrap: "border-emerald-500/40 bg-[rgba(6,78,59,0.5)]",
  },
];

const integrations = [
  {
    name: "Criteo Retail Media",
    body: "Full support for sponsored product activations, dynamic catalog syndication, and European retailer network sync.",
    logo: ImgLogoCriteo,
  },
  {
    name: "CitrusAd",
    body: "Native execution for tier-1 grocery, supermarket and FMCG networks across the UK, Europe and North America.",
    logo: ImgLogoCitrusAd,
  },
  {
    name: "Amazon Ads",
    body: "Sponsored Products and Sponsored Brands automation. Sync campaign structures, budgets and positive/negative keywords.",
    logo: ImgLogoAmazonAds,
  },
  {
    name: "Kevel",
    body: "Retail media ad serving and campaign automation. Sync campaign structures, budgets, targeting rules and sponsored ad placements.",
    logo: ImgLogoKevel,
  },
];

const differentiationItems = [
  {
    title: "Create once, activate across networks",
    body: "Move from retailer-by-retailer setup to one streamlined campaign workflow that reaches your connected networks from a single starting point.",
    icon: IconDiffCreate,
    iconBg: "bg-[#fffbeb]",
  },
  {
    title: "Standardize the view",
    body: "Normalize conflicting retailer metrics into an apples-to-apples reporting layer. Give clients transparent cross-network clarity without spreadsheet gymnastics.",
    icon: IconDiffStandardize,
    iconBg: "bg-[#f0fdfa]",
  },
  {
    title: "Stay in control",
    body: "Use automation to remove repetitive work while keeping strategy and decisions with your team.",
    icon: IconDiffControl,
    iconBg: "bg-[#ecfdf5]",
  },
];
---

<Layout seo={seo}>
  <Fragment slot="head">
    <link
      rel="preload"
      href={optimizedHeroIllustration.src}
      as="image"
      type="image/webp"
      media="(min-width: 1100px)"
    />
  </Fragment>
  {/* —— Hero —— */}
  <section class="bg-surface-page relative overflow-hidden">
    <div
      class="hero-background container-content relative grid min-h-[420px] items-center py-16 lg:min-h-[548px] lg:py-[85px]"
      style={`--hero-illustration: url(${optimizedHeroIllustration.src});`}
    >
      <div
        class="relative z-10 mx-auto max-w-xl text-center lg:mx-0 lg:max-w-[605px] lg:text-left"
      >
        <h1
          class="font-display text-ink-950 text-4xl leading-tight font-bold tracking-[-0.04em] sm:text-5xl lg:text-[68px] lg:leading-[68px] lg:tracking-[-1.7px]"
        >
          The simpler way{" "}
          <span
            class="bg-gradient-to-r from-amber-600 via-teal-700 to-[#115e59] bg-clip-text text-transparent"
          >
            to run Retail Media.
          </span>
        </h1>
        <p
          class="text-ink-600 mt-6 max-w-xl text-lg leading-8 sm:text-2xl sm:leading-8"
        >
          More retailers. More campaigns. Shouldn’t mean more admin. Triffecta
          brings campaigns and performance together, so retail media teams can
          move faster and stay in control
        </p>
        <div class="mt-9">
          <TriffectaButton
            href="/lets-talk"
            variant="dark"
            className="!rounded-design-md !px-7 !py-3.5 !text-base !leading-6"
          >
            Let's talk retail media →
          </TriffectaButton>
        </div>
      </div>
    </div>
  </section>

  {/* —— Trust —— */}
  <section
    class="border-border-default/80 bg-surface-page/50 border-y py-10 lg:py-12"
  >
    <div
      class="container-content flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between"
    >
      <div class="mx-auto max-w-xs shrink-0 text-center lg:mx-0 lg:text-left">
        <p
          class="font-display text-ink-500 text-xs leading-4 font-bold tracking-[0.6px] uppercase"
        >
          Built for teams managing retail media at scale
        </p>
        <p class="text-ink-500 mt-1 text-xs leading-4 italic">
          Trusted by performance agencies &amp; high-volume brand networks
        </p>
      </div>
      <div
        class="flex flex-wrap items-center justify-start gap-8 opacity-80 grayscale lg:justify-center lg:gap-[62px]"
        aria-label="Trusted organisations"
      >
        <img
          src={IconTrustVml}
          alt="VML"
          class="h-9 w-auto max-w-[125px] object-contain"
          width="125"
          height="36"
          loading="lazy"
        />
        <img
          src={IconTrustWppMedia}
          alt="WPP Media"
          class="h-8 w-auto max-w-[180px] object-contain sm:h-10 sm:max-w-[230px]"
          width="230"
          height="40"
          loading="lazy"
        />
        <img
          src={IconTrustPublicis}
          alt="Publicis Groupe"
          class="h-14 w-auto max-w-[90px] object-contain"
          width="90"
          height="79"
          loading="lazy"
        />
      </div>
      <div
        class="border-border-default bg-surface rounded-pill shadow-card inline-flex shrink-0 items-center border px-4 py-2"
      >
        <span class="text-ink-400 text-xs leading-4 font-medium">Backed by</span
        >
        <img
          src={IconTrustHaatch}
          alt="Haatch"
          class="ml-2 h-6 w-auto max-w-[80px] object-contain grayscale"
          width="80"
          height="24"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  {/* —— Problem —— */}
  <section class="bg-surface-page py-section">
    <div class="container-content gap-section-stack flex flex-col">
      <header
        class="mx-auto max-w-3xl text-center lg:mx-0 lg:max-w-[70%] lg:text-left"
      >
        <p
          class="font-display text-xs leading-4 font-bold tracking-[1.2px] text-amber-600 uppercase"
        >
          The cost of fragmentation
        </p>
        <h2
          class="font-display text-ink-900 mt-3.5 text-3xl leading-tight font-bold tracking-[-0.025em] sm:text-5xl sm:leading-[48px] sm:tracking-[-1.2px]"
        >
          More networks shouldn’t mean more resources.
        </h2>
        <p class="text-ink-600 mt-5 text-lg leading-[29.25px]">
          Every new retail media network can introduce another setup flow,
          reporting view, ROAS definition and way of working. The result is a
          growing operational burden at exactly the point your team needs more
          pace, clarity and control.
        </p>
      </header>
      <div class="gap-card-gap grid md:grid-cols-2 lg:grid-cols-3">
        {
          problemCards.map((card) => (
            <article class="border-border-default bg-surface rounded-design-lg shadow-card relative flex flex-col justify-between overflow-hidden border p-8">
              <div
                class={`pointer-events-none absolute top-0 right-0 size-24 rounded-bl-full opacity-60 ${card.blobClass}`}
                aria-hidden="true"
              />
              <div class="relative">
                <p
                  class={`font-display text-xs leading-4 font-bold tracking-[0.6px] uppercase ${card.labelClass}`}
                >
                  {card.label}
                </p>
                <h3 class="font-display text-ink-900 mt-3 text-xl leading-7 font-bold tracking-[-0.5px]">
                  {card.title}
                </h3>
                <p class="text-ink-600 mt-3 text-sm leading-[22.75px]">
                  {card.body}
                </p>
              </div>
              <div class="border-ink-100 relative mt-8 border-t pt-6">
                <div class="flex items-center gap-2">
                  <img
                    src={IconProblemCost}
                    alt=""
                    class="size-4 shrink-0"
                    aria-hidden="true"
                  />
                  <p class="text-xs leading-4 font-medium text-rose-600">
                    {card.cost}
                  </p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* —— Journey —— */}
  <section class="bg-ink-900 py-section relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 opacity-40"
      aria-hidden="true"
      style="background-image:
        linear-gradient(90deg, rgba(255,255,255,0.04) 1.7857%, rgba(255,255,255,0) 1.7857%),
        linear-gradient(180deg, rgba(255,255,255,0.04) 1.7857%, rgba(255,255,255,0) 1.7857%);
        background-size: 56px 56px;"
    >
    </div>
    <div class="container-content gap-section-stack relative flex flex-col">
      <header
        class="mx-auto max-w-3xl text-center lg:mx-0 lg:max-w-[70%] lg:text-left"
      >
        <p
          class="font-display text-xs leading-4 font-bold tracking-[1.2px] text-teal-500 uppercase"
        >
          Operating model
        </p>
        <h2
          class="font-display mt-6 text-3xl leading-tight font-bold tracking-[-0.025em] text-white sm:text-5xl sm:leading-[48px] sm:tracking-[-1.2px]"
        >
          One campaign.<br />
          <span
            class="bg-gradient-to-r from-amber-500 via-emerald-500 to-teal-600 bg-clip-text text-transparent"
          >
            Connected execution.
          </span>
        </h2>
        <p class="text-ink-300 mt-6 text-xl leading-7">
          Build campaigns once, activate them across connected retail media
          networks, and bring performance back to one consistent view.
        </p>
      </header>

      <div class="relative grid gap-8 pt-4 lg:grid-cols-3 lg:gap-12">
        {/* Connector through left-aligned number-badge centres (desktop) */}
        <div
          class="pointer-events-none absolute top-[4.5rem] right-[calc((100%-6rem)/3-3.5rem)] left-[3.5rem] z-0 hidden h-0.5 bg-gradient-to-r from-amber-500 via-emerald-500 to-teal-600 lg:block"
          aria-hidden="true"
        >
        </div>
        {
          journeyStations.map((station) => (
            <article class="rounded-design-md border-ink-800 bg-ink-950/80 relative z-10 flex flex-col justify-between border p-8">
              <div>
                <div
                  class={`rounded-design-md bg-ink-900 mb-4 flex size-12 items-center justify-center border font-mono text-lg leading-7 font-bold ${station.numClass}`}
                >
                  {station.num}
                </div>
                <h3 class="font-display mt-4 text-2xl leading-8 font-bold tracking-[-0.84px] text-white">
                  {station.title}
                </h3>
                <p class="text-ink-400 mt-3.5 text-sm leading-[22.75px]">
                  {station.body}
                </p>
              </div>
              <ul class="border-ink-800/80 mt-8 space-y-3 border-t pt-6">
                {station.bullets.map((item) => (
                  <li class="text-ink-300 flex items-center gap-2 text-sm leading-4">
                    <span class={station.bulletClass} aria-hidden="true">
                      ▸
                    </span>
                    {item}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <div
        class="rounded-design-lg from-ink-950/90 flex flex-col gap-4 border border-teal-300/60 bg-gradient-to-r via-[#080f23]/85 to-[#050c1e]/90 p-6 sm:flex-row sm:items-center sm:justify-between"
      >
        <div class="flex items-start gap-4 sm:items-center">
          <div
            class="rounded-design-md bg-ink-900 flex size-10 shrink-0 items-center justify-center"
          >
            <img
              src={IconJourneyAutomation}
              alt=""
              class="size-6"
              aria-hidden="true"
            />
          </div>
          <div>
            <p
              class="font-display text-base leading-6 font-bold tracking-[-0.4px] text-white"
            >
              Intelligent Automation Layer Active
            </p>
            <p class="text-ink-400 mt-0.5 text-xs leading-4">
              Handling manual pacing, keyword discovery and catalog updates
              without relinquishing strategic control.
            </p>
          </div>
        </div>
        <div
          class="rounded-design-sm border-ink-800 bg-ink-900/70 inline-flex items-center gap-2 border px-4 py-2"
        >
          <span class="text-xs leading-4 font-semibold text-emerald-500"
            >Continuous Health Checks</span
          >
          <span class="size-2 rounded-full bg-emerald-500" aria-hidden="true"
          ></span>
        </div>
      </div>
    </div>
  </section>

  {/* —— Platform Proof —— */}
  <section class="bg-ink-950 py-section relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0"
      aria-hidden="true"
      style="background: radial-gradient(ellipse 50% 40% at 80% 20%, rgba(13,148,136,0.18), transparent 60%);"
    >
    </div>
    <div class="container-content gap-section-stack relative flex flex-col">
      <header
        class="mx-auto max-w-3xl text-center lg:mx-0 lg:max-w-[70%] lg:text-left"
      >
        <p
          class="font-display text-xs leading-4 font-bold tracking-[1.2px] text-amber-500 uppercase"
        >
          The platform
        </p>
        <h2
          class="font-display mt-3.5 text-3xl leading-tight font-bold tracking-[-0.025em] text-white sm:text-5xl sm:leading-[48px] sm:tracking-[-1.2px]"
        >
          Built for teams executing Retail Media.
        </h2>
        <p class="text-ink-300 mt-5 text-xl leading-7">
          Run campaigns, compare retailer performance and manage your
          retail-media operation from one environment - without giving up the
          visibility or control your team needs.
        </p>
      </header>

      <div
        class="rounded-design-lg border-ink-800 bg-ink-900/90 shadow-elevated overflow-hidden border p-4 backdrop-blur-[12px]"
      >
        <div
          class="border-ink-800 mb-3 flex items-center gap-2 border-b px-3 pt-2 pb-2.5"
        >
          <span class="size-3 rounded-full bg-rose-500/80" aria-hidden="true"
          ></span>
          <span class="size-3 rounded-full bg-amber-500/80" aria-hidden="true"
          ></span>
          <span class="size-3 rounded-full bg-emerald-500/80" aria-hidden="true"
          ></span>
          <span
            class="text-ink-500 ml-2 truncate font-mono text-[11px] leading-4"
          >
            portal.triffecta.com/organizations/northstar-media-group/dashboard
          </span>
        </div>
        <div class="rounded-design-md border-ink-800/60 overflow-hidden border">
          <Picture
            src={ImgPlatformDashboard}
            formats={["avif", "webp", "png"]}
            widths={[800, 1200, 1600, 1955]}
            sizes="(min-width: 1280px) 1232px, 100vw"
            alt="Triffecta multi-retailer analytics dashboard"
            loading="lazy"
            class="h-auto w-full object-cover object-top"
          />
        </div>
      </div>

      <div
        class="gap-card-gap border-ink-800/80 grid border-t pt-16 md:grid-cols-2 lg:grid-cols-3"
      >
        {
          platformPillars.map((pillar) => (
            <article class="rounded-design-md border-ink-800 bg-ink-900/60 border p-6">
              <div
                class={`rounded-design-sm mb-2 flex size-10 items-center justify-center border ${pillar.iconWrap}`}
              >
                <img
                  src={pillar.icon}
                  alt=""
                  class="size-5"
                  aria-hidden="true"
                />
              </div>
              <h3 class="font-display mt-3 text-lg leading-7 font-bold tracking-[-0.45px] text-white">
                {pillar.title}
              </h3>
              <p class="text-ink-400 mt-1.5 text-sm leading-[22.75px]">
                {pillar.body}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* —— Integrations —— */}
  <section class="border-border-default bg-surface py-section border-b">
    <div class="container-content flex flex-col gap-12">
      <header
        class="mx-auto max-w-3xl text-center lg:mx-0 lg:max-w-[70%] lg:text-left"
      >
        <p
          class="font-display text-xs leading-4 font-bold tracking-[1.2px] text-teal-700 uppercase"
        >
          Connected ecosystem
        </p>
        <h2
          class="font-display text-ink-950 mt-4 text-3xl leading-tight font-bold tracking-[-0.025em] sm:text-5xl sm:leading-[48px] sm:tracking-[-1.2px]"
        >
          Connect the retail media platforms you already use.
        </h2>
        <p class="text-ink-600 mt-4 text-lg leading-7">
          Triffecta sits within your existing retail media stack - not beside it
          or above it.
        </p>
      </header>
      <div class="gap-card-gap grid sm:grid-cols-2">
        {
          integrations.map((item) => (
            <article class="rounded-design-lg border-border-default bg-surface-page/50 flex flex-col gap-2 border p-8">
              <div class="flex items-center justify-between gap-4">
                <img
                  src={item.logo.src}
                  alt=""
                  width={item.logo.width}
                  height={item.logo.height}
                  class="rounded-design-sm h-10 w-auto max-w-[160px] object-contain"
                  loading="lazy"
                  aria-hidden="true"
                />
                <span class="rounded-pill bg-emerald-100 px-2.5 py-1 text-xs leading-4 font-semibold text-emerald-800">
                  Direct API
                </span>
              </div>
              <h3 class="font-display text-ink-900 mt-4 text-xl leading-7 font-bold tracking-[-0.5px]">
                {item.name}
              </h3>
              <p class="text-ink-600 text-sm leading-[22.75px]">{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* —— Commercial —— */}
  <section class="bg-ink-900 py-section relative overflow-hidden">
    <div
      class="pointer-events-none absolute top-[10%] left-1/2 h-[50%] w-[700px] -translate-x-1/2 rounded-full blur-[60px]"
      aria-hidden="true"
      style="background: linear-gradient(24deg, rgba(20,184,166,0.1), rgba(16,185,129,0.1), rgba(245,158,11,0.05));"
    >
    </div>
    <div class="container-content relative">
      <header
        class="mx-auto mb-14 max-w-3xl text-center lg:mx-0 lg:max-w-[70%] lg:text-left"
      >
        <p
          class="font-display text-xs leading-4 font-bold tracking-[1.2px] text-amber-500 uppercase"
        >
          No growth tax
        </p>
        <h2
          class="font-display mt-6 text-3xl leading-tight font-bold tracking-[-0.025em] text-white sm:text-5xl sm:leading-[48px] sm:tracking-[-1.2px]"
        >
          Grow your retail media.<br />
          <span
            class="bg-gradient-to-r from-amber-400 via-emerald-300 to-teal-300 bg-clip-text text-transparent"
          >
            Not your software bill.
          </span>
        </h2>
        <p
          class="text-ink-300 mx-auto mt-6 max-w-2xl text-xl leading-7 lg:mx-0"
        >
