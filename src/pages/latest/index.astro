---
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import IconTriffecta from "../../components/icon/IconTriffecta.tsx";
import { getCollection } from "astro:content";
import { getImage, Picture } from "astro:assets";
import ImgHeroLights from "../../assets/hero-lights.png";

const optimizedImgHeroLights = await getImage({
  src: ImgHeroLights,
  format: "webp",
});

const posts = await getCollection("posts");
posts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const accents = ["amber", "teal", "emerald"] as const;

const seo = {
  title: "Latest Updates",
  description: "Stay updated with the latest news and events from Triffecta.",
  path: "/latest/",
};
---

<Fragment slot="head">
  <link rel="preload" href={optimizedImgHeroLights.src} as="image" />
</Fragment>
<Layout seo={seo}>
  <section class="bg-secondary relative overflow-hidden py-18 text-white">
    <div class="relative z-10 container mx-auto">
      <div class="relative z-20">
        <div class="inline-block rounded-lg bg-[rgba(38,50,56,0.75)] p-4">
          <h1
            class="page-hero-title text-4xl text-wrap text-clip sm:text-5xl md:text-6xl"
          >
            Latest
          </h1>
        </div>
      </div>
      <div
        class="absolute top-[-20%] left-[-75%] z-10 sm:top-[-300%] sm:left-[-20%]"
      >
        <IconTriffecta size="1000px" strokeWidth="0.7" rotate={212} />
      </div>
    </div>

    <Picture
      id="hero"
      src={ImgHeroLights}
      formats={["webp", "avif", "png"]}
      widths={[480, 768, 1280, 1920]}
      sizes="100vw"
      alt="A picture of a woman shopping for groceries"
      fetchpriority="high"
      loading="eager"
      class="absolute top-0 left-0 z-0 h-full w-full object-cover object-bottom"
    />
  </section>

  <section class="page-shell py-section relative overflow-hidden">
    <div class="container-content">
      <div class="gap-card-gap grid sm:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post, i) => (
            <PostCard post={post} accent={accents[i % accents.length]} />
          ))
        }
      </div>
    </div>
  </section>
</Layout>
